# FitSport Environment Configuration

PORT=3000
DATABASE_URL=postgresql://fitsport_user:password@localhost:5432/fitsport_db
JWT_SECRET=fitsport_super_secret_jwt_key_2026

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Telegram Bot Integration (Replaces WhatsApp)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Ollama Local LLM Configuration (Fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Open-Source Whisper STT Configuration
WHISPER_MODEL=base
WHISPER_PATH=whisper

# Open-Source Piper TTS Configuration
PIPER_PATH=piper
PIPER_MODEL=en_US-lessac-medium.onnx

# Twilio WhatsApp Integration (Scheduled daily summary delivery only — NO OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# AI Request Limits
AI_MAX_AUDIO_SIZE=10485760
AI_REQUEST_TIMEOUT=15000
